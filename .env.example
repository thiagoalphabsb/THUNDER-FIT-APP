# ==========================================
# THUNDER - Environment Variables Template
# ==========================================

# GEMINI_API_KEY: Required for Gemini AI Strength Coach and Insights.
# Server-side only (never exposed to browser client).
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# APP_URL: Host application URL.
APP_URL="http://localhost:3000"

# PORT: Server listening port (default: 3000)
PORT=3000

# ==========================================
# FIREBASE WEB CONFIGURATION (Client-side)
# Required if syncing with your own Firebase project.
# Alternatively, copy firebase-applet-config.example.json to firebase-applet-config.json
# ==========================================
VITE_FIREBASE_API_KEY="AIzaSy_YOUR_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"
VITE_FIREBASE_FIRESTORE_DATABASE_ID="(default)"
VITE_FIREBASE_OAUTH_CLIENT_ID="123456789012-example.apps.googleusercontent.com"
